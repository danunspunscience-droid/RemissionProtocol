{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "npx wrangler pages dev dist/apps/web",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "start-session": "./scripts/session-start.sh",
    "end-session": "./scripts/session-end.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}